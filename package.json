{
  "name": "memo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test 'specs/**/*.spec.ts'",
    "format": "prettier --write '**/*.{ts,js,html,css,md,json}'",
    "format:check": "prettier --check '**/*.{ts,js,html,css,md,json}'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:specs": "tsc --noEmit -p tsconfig.spec.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@catppuccin/codemirror": "^1.0.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@fig/lezer-bash": "^1.2.5",
    "@lezer/highlight": "^1.2.3",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "openpgp": "^6.3.1"
  }
}
